# Copy to .env. Every value here is OPTIONAL except CLANK_LOCAL_URL:
# with no keys at all the agent runs entirely on the local model.

# The local OpenAI-compatible endpoint. This is the floor and the workhorse.
CLANK_LOCAL_URL=http://127.0.0.1:8080/v1
CLANK_LOCAL_MODEL=qwen38-27b

# Optional: if the model server runs on another machine, clank will start it.
# CLANK_SSH_HOST=user@100.64.0.1
# CLANK_START_CMD=~/qwen-start.sh
# CLANK_STOP_CMD=~/qwen-stop.sh

# Optional: one OpenRouter key unlocks the free frontier lane (planning, sweeps).
# A funded account is not required for the free models, but a small balance
# raises the rate limits that free endpoints are subject to.
# OPENROUTER_API_KEY=sk-or-v1-...

# Optional: one Groq key unlocks the wide parallel distill lane for research.
# Without it, research automatically narrows to fewer, better-chosen pages.
# GROQ_API_KEY=gsk_...

# Optional: a local SearXNG instance. Without it, research falls back to the
# planner's seed URLs plus link harvesting, which is the higher-precision path
# anyway.
# CLANK_SEARXNG=http://127.0.0.1:8080/search

