#!/usr/bin/env bash
# lca -- local coding agent. One word, the same reflexes as `claude`.
#
#   lca                      open the agent here
#   lca "add retries to X"   do the task, report back
#   lca -i "..."             open the agent with that prompt loaded
#   lca -c                   continue the last session
#   lca -r                   pick a past session and resume it
#   lca loop "..."           work until done, no handback
#   lca research "..."       deep research -> cited answer + .agent/research/*.md
#   lca sweep "goal" f1 f2   frontier architecture sweep -> .agent/sweeps/*.md
#   lca self                 open the agent on its own source
#   lca status | up | down | doctor | init
#
# Permissions are skipped by default. That is deliberate and it is why this
# feels like a tool rather than a dialogue.
set -u
LCA_HOME="${LCA_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
export LCA_HOME
PORT="${LCA_PORT:-8787}"
[ -f "$LCA_HOME/.env" ] && set -a && . "$LCA_HOME/.env" && set +a
LOCAL_URL="${LCA_LOCAL_URL:-http://127.0.0.1:8080/v1}"
AORUS="${LCA_SSH_HOST:-}"                 # optional: host to ssh into to start the model server
START_CMD="${LCA_START_CMD:-~/qwen-start.sh}"
STOP_CMD="${LCA_STOP_CMD:-~/qwen-stop.sh}"
export OPENCODE_CONFIG="$LCA_HOME/opencode.json"
export PATH="${LCA_NODE_BIN:-$HOME/.nvm/versions/node/v22.18.0/bin}:$PATH"
OC=(opencode)
say() { printf '%s\n' "$*" >&2; }

local_up()  { curl -sf --max-time 6 "$LOCAL_URL/models" >/dev/null 2>&1; }
router_up() { curl -sf --max-time 3 "http://127.0.0.1:$PORT/v1/models" >/dev/null 2>&1; }

up() {
  if ! local_up; then
    if [ -n "$AORUS" ]; then
      say "· model server down — starting it on $AORUS"
      ssh -o ConnectTimeout=8 -o BatchMode=yes "$AORUS" "$START_CMD" >/dev/null 2>&1 &
      for _ in $(seq 1 60); do local_up && break; sleep 3; done
    fi
  fi
  local_up && say "· local model  up   ($LOCAL_URL)" \
           || say "· local model  DOWN — cloud routes still work, the floor does not"
  if ! router_up; then
    ( cd "$LCA_HOME" && mkdir -p logs && setsid nohup python3 router/gateway.py \
        > logs/router.out 2>&1 < /dev/null & )
    for _ in $(seq 1 24); do router_up && break; sleep 0.5; done
  fi
  router_up && say "· router       up   (127.0.0.1:$PORT)" || { say "· router       FAILED — see $LCA_HOME/logs/router.out"; exit 1; }
}

# Session picker. opencode stores sessions globally; default to the ones opened
# in this directory, because that is what "resume" almost always means.
pick_session() {
  local all="${1:-}"
  local js; js=$("${OC[@]}" session list --format json -n 200 2>/dev/null)
  [ -z "$js" ] && { say "no sessions yet"; return 1; }
  python3 - "$PWD" "$all" <<'PY'
import json, sys, os, time, subprocess
cwd, allf = sys.argv[1], sys.argv[2]
rows = json.loads(sys.stdin.read() or "[]")
if not allf:
    here = [r for r in rows if (r.get("directory") or "").startswith(cwd)]
    rows = here or rows
rows = rows[:30]
if not rows:
    sys.exit(1)
for i, r in enumerate(rows, 1):
    ago = (time.time()*1000 - r.get("updated", 0)) / 3600000.0
    when = f"{ago:.0f}h ago" if ago < 48 else time.strftime("%b %d", time.localtime(r.get("updated",0)/1000))
    d = os.path.basename(r.get("directory") or "")
    print(f"\033[2m{i:>3}\033[0m  \033[2m{when:>8}\033[0m  {r.get('title','(untitled)')[:66]:<66} \033[2m{d}\033[0m",
          file=sys.stderr)
print("", file=sys.stderr)
try:
    sel = input("  session # (enter = newest): ").strip() or "1"
    print(rows[int(sel)-1]["id"])
except (EOFError, KeyboardInterrupt, ValueError, IndexError):
    sys.exit(1)
PY
}

case "${1:-tui}" in
  tui) up; exec "${OC[@]}" --auto ;;

  -c|--continue) up; shift; exec "${OC[@]}" --auto --continue "$@" ;;

  -r|--resume)
    up; shift
    ALL=""; [ "${1:-}" = "-a" ] && ALL=1
    SID=$(pick_session "$ALL") || { say "cancelled"; exit 1; }
    exec "${OC[@]}" --auto --session "$SID" ;;

  -i|--interactive) up; shift; exec "${OC[@]}" --auto --prompt "$*" ;;

  # Work until the task is actually finished, without asking me anything.
  #
  # The sentinel matters: a model told to "keep going" will keep going forever.
  # It is given one exact string to emit when done, and the loop watches for it.
  # Two independent stops back it up -- an iteration cap, and a repeat detector
  # for the case where the model emits the same text twice and has plainly
  # stopped making progress.
  loop)
    up; shift
    TASK="$*"; MAX="${LCA_LOOP_MAX:-14}"; PREV=""
    PROTO='Work autonomously until this task is genuinely complete. Do not ask me questions; make the reasonable choice and record it. Verify your own work — run the tests, run the code. When and ONLY when everything is done and verified, end your reply with the exact line: LCA-TASK-COMPLETE'
    say "· loop mode (max $MAX iterations, stop word LCA-TASK-COMPLETE)"
    OUT=$("${OC[@]}" run --auto --agent build "$TASK

$PROTO" 2>&1) ; printf '%s\n' "$OUT"
    i=1
    while [ "$i" -lt "$MAX" ]; do
      case "$OUT" in *LCA-TASK-COMPLETE*) say "· complete after $i iteration(s)"; exit 0 ;; esac
      if [ "$OUT" = "$PREV" ]; then say "· output repeated verbatim — no progress, stopping"; exit 1; fi
      PREV="$OUT"; i=$((i+1))
      say "· iteration $i"
      OUT=$("${OC[@]}" run --auto --continue "Continue. $PROTO" 2>&1); printf '%s\n' "$OUT"
    done
    say "· hit the $MAX-iteration cap without completion — resume with: lca -c" ; exit 1 ;;

  research) up >&2; shift; exec python3 "$LCA_HOME/mcp/research.py" --cli "$@" ;;

  sweep)
    up >&2; shift
    G="$1"; shift
    exec python3 "$LCA_HOME/mcp/sweep.py" --cli "$G" "$@" ;;

  self) up; exec "${OC[@]}" --auto "$LCA_HOME" ;;

  init)
    mkdir -p .agent/{research,sweeps,decisions}
    [ -f .agent/MEMORY.md ] || printf '# Project memory\n\nDurable facts. One per line. Loaded at the start of every session.\n\n' > .agent/MEMORY.md
    python3 "$LCA_HOME/mcp/memory.py" <<< '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"repomap","arguments":{}}}' >/dev/null
    say "· .agent/ initialised — repomap.md built" ;;

  status)
    local_up  && echo "local model  UP    $LOCAL_URL" || echo "local model  down  $LOCAL_URL"
    router_up && echo "router       UP    127.0.0.1:$PORT" || { echo "router       down"; exit 0; }
    curl -sf --max-time 5 "http://127.0.0.1:$PORT/v1/health" | python3 -c "
import json,sys
d=json.load(sys.stdin)
print(f\"pool         {d['pool_source']}  keys: openrouter={d['openrouter_keys']} groq={d['groq_keys']}\")
print('frontier ladder (best first):')
for f in d['frontier'][:6]:
    c=f\"  cooling {f['cooling_s']}s\" if f['cooling_s'] else ''
    print(f\"  {f['rank']:>5}  {f['model']:<48} {f['ctx']:>8}{c}\")"
    echo; echo "last 8 routes:"
    tail -8 "$LCA_HOME/logs/calls.jsonl" 2>/dev/null | python3 -c "
import json,sys
for l in sys.stdin:
    d=json.loads(l)
    n=len(d.get('attempts') or [])
    print(f\"  {d['virtual']:<8} -> {str(d['chosen']):<46} {d['total_s']:>7}s  {n} attempt(s)\")" ;;

  doctor)
    echo "LCA_HOME     $LCA_HOME"
    echo "config       $OPENCODE_CONFIG"
    command -v opencode >/dev/null && echo "opencode     $("${OC[@]}" --version 2>/dev/null)" || echo "opencode     MISSING"
    [ -x "$LCA_HOME/fetcher/target/release/lca-fetch" ] && echo "fetcher      built" || echo "fetcher      NOT BUILT — cargo build --release --manifest-path $LCA_HOME/fetcher/Cargo.toml"
    local_up && echo "local model  reachable" || echo "local model  UNREACHABLE at $LOCAL_URL"
    router_up && echo "router       reachable" || echo "router       not running (starts on demand)"
    [ -f "$LCA_HOME/.env" ] && echo "keys         .env present" || echo "keys         no .env — local-only mode (this is a supported configuration)"
    curl -sf --max-time 8 "${LCA_SEARXNG:-http://127.0.0.1:8080/search}?q=test&format=json" >/dev/null 2>&1 \
      && echo "searxng      reachable" || echo "searxng      unreachable — research falls back to planner seeds + link harvest" ;;

  stop)
    P=$(pgrep -f 'router/gateway\.py' | head -1)
    [ -n "$P" ] && kill "$P" && echo "router stopped" || echo "router not running" ;;

  down)
    P=$(pgrep -f 'router/gateway\.py' | head -1); [ -n "$P" ] && kill "$P" && echo "router stopped"
    [ -n "$AORUS" ] && ssh -o ConnectTimeout=8 "$AORUS" "$STOP_CMD" && echo "model server stopped" ;;

  -h|--help|help) sed -n '2,20p' "$(readlink -f "$0")" | sed 's/^# \{0,1\}//' ;;

  # Anything else is a task: do it and hand back.
  *) up >&2; exec "${OC[@]}" run --auto "$@" ;;
esac
